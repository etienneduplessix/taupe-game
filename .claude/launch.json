{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docker-compose (full stack)",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["up"],
      "port": 8080
    },
    {
      "name": "frontend (Nuxt dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    },
    {
      "name": "backend (Uvicorn)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--app-dir", "backend"],
      "port": 8000
    }
  ]
}
